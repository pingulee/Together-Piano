# ---------------------------------------------------------------------------
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. .env.local 은 커밋되지 않습니다.
# ---------------------------------------------------------------------------

# --- 서버 ---
PORT=3000
# 컨테이너에서 외부(터널)의 접속을 받으려면 0.0.0.0
HOST=0.0.0.0
# 브라우저가 접속하는 공개 호스트명
HOSTNAME=piano.pingulee.dev
# 소켓 CORS 허용 오리진. 쉼표로 여러 개 지정 가능.
# NODE_ENV=production 이면 반드시 설정해야 하며, 미설정 시 서버가 뜨지 않습니다.
CORS_ORIGIN=https://piano.pingulee.dev

# --- 클라이언트 ---
# 소켓 서버 주소. Next 와 소켓이 한 프로세스이므로 비워 두면 같은 오리진에 접속합니다.
# 이 값은 빌드 시점에 번들에 치환되므로, 바꾸면 이미지를 다시 빌드해야 합니다.
NEXT_PUBLIC_SOCKET_URL=
# 국가 코드 조회 API (채팅 국기 표시에만 사용, 실패해도 앱은 동작)
NEXT_PUBLIC_GEOLOCATION_API_URL=

# --- 데이터베이스 (SQLite) ---
# 컨테이너에서는 볼륨으로 마운트한 경로여야 재배포 후에도 로그인 정보가 남습니다.
DATABASE_PATH=/data/app.db

# --- 인증 (NextAuth) ---
# openssl rand -base64 32
NEXTAUTH_SECRET=
# OAuth 콜백이 이 주소를 기준으로 만들어집니다. 반드시 https 여야 합니다.
NEXTAUTH_URL=https://piano.pingulee.dev

# Google Cloud Console > 사용자 인증 정보 > OAuth 클라이언트
# 승인된 리디렉션 URI: https://piano.pingulee.dev/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord Developer Portal > OAuth2 > Redirects
# https://piano.pingulee.dev/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
